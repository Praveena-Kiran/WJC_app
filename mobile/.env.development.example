# .env.development.example — Zengo Mobile (development)
# Copy to .env.development and fill in your values.
# This file IS tracked by git (as a template). .env.development is gitignored.
#
# EXPO_PUBLIC_* variables are bundled into the client JS bundle by Metro.
# All other variables are server-only and invisible to the mobile app.

# ── Client-visible ───────────────────────────────────────────────────────────
# The API base URL used by apiFetch() in the Expo Go client.
# Set this to your machine's LAN IP (e.g. http://192.168.1.42:8081) when
# testing on a physical device. Simulators can use http://localhost:8081.
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:8081

# Optional: Sentry DSN for error reporting (safe to leave empty in dev).
EXPO_PUBLIC_SENTRY_DSN=

# ── Server-only ───────────────────────────────────────────────────────────────
# Neon Postgres connection string. Get from https://console.neon.tech/
DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Better Auth secret (32+ random bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-64-char-random-secret

# Better Auth base URL (must match where the auth handler is served).
BETTER_AUTH_URL=http://localhost:8081

# AWS S3 (optional — needed for teacher file uploads).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=zengo-study-files
